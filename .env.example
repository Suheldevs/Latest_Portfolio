# Copy this file to .env and fill in the value. .env is gitignored.
#
# Web3Forms access key — powers the contact form on /.
# Get one free at https://web3forms.com: enter mohdsuhel.dev@gmail.com and the
# key arrives by email. Without it the form falls back to opening the visitor's
# mail client with the message pre-filled.
#
# On Netlify, set this under Site settings → Environment variables instead;
# a .env file is not deployed.
VITE_WEB3FORMS_ACCESS_KEY=
